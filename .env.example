# Copy to .env for local runs. In CI, set these as secrets/variables instead.

# Folder holding suite.yml, personas.yml and the case files. Relative paths are relative to this
# folder. Unset = ./config. A folder that does not exist is an error.
# SEMTEST_CONFIG_DIR=../my-team-config

# --- Cube environment under test -----------------------------------------------------------
# REST base URL ending in /cubejs-api. Cube Cloud: Overview -> API credentials -> REST API.
# For a PR, use the branch's staging environment URL; for post-load checks, production.
CUBE_API_URL=https://your-deployment.gcp-australia-southeast1.cubecloudapp.dev/cubejs-api
# The deployment's CUBEJS_API_SECRET (Settings -> Environment variables). Used ONLY to sign
# short-lived test tokens for the personas in config/personas.yml. Treat as a secret.
CUBE_API_SECRET=
CUBE_QUERY_TIMEOUT=300

# --- Cube Cloud Control Plane (compile check; optional) -------------------------------------
CUBE_CLOUD_HOST=https://your-tenant.cubecloud.dev
CUBE_CLOUD_API_KEY=
CUBE_DEPLOYMENT_ID=
# Branch to compile; unset = production branch.
CUBE_BRANCH=

# --- BigQuery (parity and rollup value checks) -----------------------------------------------
BQ_PROJECT=your-project
BQ_LOCATION=australia-southeast1
# Hard cap per reference query (bytes). 5 GiB default.
BQ_MAX_BYTES_BILLED=5368709120
